    "Snap, resize and move windows with trackpad gestures on their title bars.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta, cambia el tamaño y mueve ventanas con gestos del trackpad en sus barras de título."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌ها را با حرکت‌های ترک‌پد روی نوار عنوانشان بچینید، اندازه‌شان را عوض کنید و جابه‌جایشان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
