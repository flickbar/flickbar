    "Repeat a swipe to a half or Fill Screen to cycle through thirds. Press Esc before lifting your fingers to cancel.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite un deslizamiento hacia una mitad o Llenar pantalla para recorrer los tercios. Pulsa Esc antes de levantar los dedos para cancelar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر کشیدن به سمت یک نیمه یا «پر کردن صفحه» را تکرار کنید، پنجره بین اندازه‌های یک‌سوم می‌چرخد. برای لغو، پیش از برداشتن انگشت‌ها Esc را بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez un balayage vers une moitié ou Remplir l’écran pour passer par les tiers. Appuyez sur Échap avant de lever les doigts pour annuler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复轻扫到二分之一或“填满屏幕”，可在三分之一之间循环切换。抬起手指前按 Esc 可取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複滑動到二分之一或「填滿螢幕」，可在三分之一之間循環切換。抬起手指前按 Esc 可取消。"
          }
        }
      }
    },
    "Report an Issue": {
      "localizations": {
        "es": {
          "stringUnit": {
