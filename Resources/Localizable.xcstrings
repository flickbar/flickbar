        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur + pour choisir une app."
          }
        }
      }
    },
    "Click Open System Settings, then turn on Flickbar. If it's already on, select it, click − to remove it, and add it again.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی «باز کردن تنظیمات سیستم» بزنید و Flickbar را روشن کنید. اگر از قبل روشن است، انتخابش کنید، با − حذفش کنید و دوباره اضافه‌اش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Ouvrir Réglages Système, puis activez Flickbar. S’il est déjà activé, sélectionnez-le, cliquez sur − pour le supprimer, puis ajoutez-le à nouveau."
          }
        }
      }
    },
