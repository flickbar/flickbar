    },
    "The gesture brings its window to the front and presses these keys. Esc cancels.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gesto trae su ventana al frente y pulsa estas teclas. Esc cancela."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این حرکت پنجره‌اش را جلو می‌آورد و این کلیدها را می‌زند. Esc لغو می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le geste place sa fenêtre au premier plan et appuie sur ces touches. Échap pour annuler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该手势会将其窗口移到最前面并按下这些按键。按 Esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此手勢會將其視窗移到最前方並按下這些按鍵。按 Esc 取消。"
          }
        }
      }
    },
