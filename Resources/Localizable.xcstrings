          }
        }
      }
    },
    "Rest two fingers until a grid appears, move to a cell, then lift.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén dos dedos apoyados hasta que aparezca una cuadrícula, desplázalos a una celda y levántalos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دو انگشت را نگه دارید تا جدول ظاهر شود، روی یک خانه بروید و انگشت‌ها را بردارید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez deux doigts jusqu’à ce qu’une grille apparaisse, allez sur une case, puis levez-les."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两指停放不动，直到出现网格，再移到某个格子并抬起手指。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩指停放不動，直到出現格線，再移到某個格子並抬起手指。"
          }
        }
      }
    },
