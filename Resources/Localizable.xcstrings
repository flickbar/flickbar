    "Swipe or pinch with two fingers on any window's title bar to snap, resize and move it.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با دو انگشت روی نوار عنوان هر پنجره بکشید، یا انگشت‌ها را جمع و باز کنید، تا پنجره را بچینید، اندازه‌اش را عوض کنید یا جابه‌جایش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez ou pincez avec deux doigts sur la barre de titre d’une fenêtre pour l’ancrer, la redimensionner et la déplacer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意窗口的标题栏上用两指轻扫或捏合，即可吸附、调整大小和移动窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何視窗的標題列上用兩指滑動或捏合，即可貼齊、調整大小和移動視窗。"
          }
        }
      }
