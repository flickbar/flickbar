    "Click + to choose an app.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای انتخاب برنامه، روی + بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur + pour choisir une app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 + 来选择 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下 + 來選擇 App。"
          }
        }
      }
    },
    "Click Open System Settings, then turn on Flickbar. If it's already on, select it, click − to remove it, and add it again.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی «باز کردن تنظیمات سیستم» بزنید و Flickbar را روشن کنید. اگر از قبل روشن است، انتخابش کنید، با − حذفش کنید و دوباره اضافه‌اش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Ouvrir Réglages Système, puis activez Flickbar. S’il est déjà activé, sélectionnez-le, cliquez sur − pour le supprimer, puis ajoutez-le à nouveau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“打开系统设置”，然后打开 Flickbar。如果它已经打开，请选中它，点按 − 将其移除，然后重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下「打開系統設定」，然後開啟 Flickbar。如果它已經開啟，請選取它，按一下 − 將其移除，然後重新加入。"
          }
        }
      }
    },
