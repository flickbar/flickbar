    "Tap the trackpad when a gesture is recognized": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta háptica en el trackpad al reconocer un gesto"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لرزش کوتاه ترک‌پد وقتی حرکت شناخته می‌شود"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire vibrer le trackpad quand un geste est reconnu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别到手势时，触控板轻震一下"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "辨識到手勢時，觸控式軌跡板輕震一下"
          }
        }
      }
    },
    "That key can't be used.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede usar esa tecla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کلید قابل استفاده نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette touche ne peut pas être utilisée."
          }
        },
