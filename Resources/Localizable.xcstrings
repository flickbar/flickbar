    "Swipe down. The window comes right back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia abajo. La ventana vuelve de inmediato."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به پایین بکشید. پنجره زود برمی‌گردد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers le bas. La fenêtre revient aussitôt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向下轻扫。窗口会马上回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向下滑動。視窗會馬上回來。"
          }
        }
      }
    },
    "Swipe left or right, then up or down.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la izquierda o a la derecha y luego hacia arriba o hacia abajo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به چپ یا راست بکشید، بعد به بالا یا پایین."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers la gauche ou la droite, puis vers le haut ou le bas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向左或向右轻扫，再向上或向下轻扫。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向左或向右滑動，再向上或向下滑動。"
          }
        }
      }
    },
    "Swipe left.": {
      "localizations": {
