    "Hold ⌘ and swipe to move a window to another display": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada ⌘ y desliza para mover una ventana a otra pantalla"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای بردن پنجره به نمایشگر دیگر، ⌘ را نگه دارید و بکشید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘ et balayez pour déplacer une fenêtre vers un autre moniteur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 并轻扫，可将窗口移到另一台显示器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 並滑動，可將視窗移到另一台顯示器"
          }
        }
      }
    },
    "If nothing happens, macOS or another app is using those keys.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no pasa nada, macOS u otra app está usando esas teclas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اتفاقی نیفتاد، macOS یا برنامه‌ای دیگر از این کلیدها استفاده می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rien ne se passe, macOS ou une autre app utilise ces touches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有反应，说明 macOS 或其他 App 正在使用这些按键。"
