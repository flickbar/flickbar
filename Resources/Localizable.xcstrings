    "Accessibility access is on. You're ready to go.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Accesibilidad está activado. Todo listo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی «دسترس‌پذیری» روشن است. همه‌چیز آماده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès Accessibilité est activé. Tout est prêt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限已打开，一切就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用權限已開啟，一切就緒。"
          }
        }
