    "Rest two fingers until a grid appears, move to a cell, then lift.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دو انگشت را نگه دارید تا جدول ظاهر شود، روی یک خانه بروید و انگشت‌ها را بردارید."
          }
