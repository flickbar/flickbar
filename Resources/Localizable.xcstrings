    "Shortcuts act on the frontmost window. Repeat a half or Fill Screen shortcut to cycle through thirds.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میان‌برها روی پنجره‌ی جلویی کار می‌کنند. اگر میان‌بر یک نیمه یا «پر کردن صفحه» را تکرار کنید، پنجره بین اندازه‌های یک‌سوم می‌چرخد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis agissent sur la fenêtre au premier plan. Répétez un raccourci de moitié ou Remplir l’écran pour passer par les tiers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键作用于最前面的窗口。重复使用二分之一或“填满屏幕”快捷键，可在三分之一之间循环切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵作用於最前方的視窗。重複使用二分之一或「填滿螢幕」快速鍵，可在三分之一之間循環切換。"
          }
        }
      }
    },
