          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans Flickbar"
          }
        }
      }
    },
    "Where": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کجا"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où"
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtre"
          }
        }
      }
    },
    "Windows": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره‌ها"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtres"
          }
        }
      }
    },
    "Works on the icons of apps that are running.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی نماد برنامه‌هایی که باز هستند کار می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne sur les icônes des apps ouvertes."
          }
        }
      }
    },
    "You can also turn gestures off for the current app from the Flickbar menu.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از منوی Flickbar هم می‌توانید حرکت‌ها را برای برنامه‌ی فعلی خاموش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi désactiver les gestes pour l’app active depuis le menu de Flickbar."
          }
        }
      }
    },
    "You're all set.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه‌چیز آماده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est prêt."
          }
        }
      }
    },
    "macOS requires this permission for apps that arrange windows. Flickbar uses it only to move and resize the windows you gesture on. It doesn't collect or send any data.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS این اجازه را برای برنامه‌هایی که پنجره‌ها را مرتب می‌کنند لازم می‌داند. Flickbar فقط برای جابه‌جا کردن و تغییر اندازه‌ی پنجره‌هایی که رویشان حرکت می‌کنید از آن استفاده می‌کند و هیچ داده‌ای جمع نمی‌کند یا نمی‌فرستد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS exige cette autorisation pour les apps qui organisent les fenêtres. Flickbar ne l’utilise que pour déplacer et redimensionner les fenêtres sur lesquelles vous faites un geste. Il ne collecte ni n’envoie aucune donnée."
          }
        }
      }
    },
    "⌃ Control": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ Control"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃ Contrôle"
          }
        }
      }
    },
    "⌥ Option": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ Option"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ Option"
          }
        }
      }
    }
  },
  "version": "1.0"
}